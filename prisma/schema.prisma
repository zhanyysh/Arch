generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  manager
  foreman
  worker
}

enum ProjectStatus {
  planned
  in_progress
  review
  completed
  frozen
}

enum StageStatus {
  not_started
  in_progress
  review
  done
  overdue
}

enum TaskStatus {
  new
  in_progress
  review
  done
  rework
}

enum MaterialStatus {
  planned
  ordered
  delivered
  used
}

enum PhotoKind {
  before
  after
}

model Company {
  id        String    @id @default(cuid())
  name      String
  phone     String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  projects  Project[]

  @@index([isActive])
}

model User {
  id           String    @id @default(cuid())
  fullName     String
  email        String    @unique
  passwordHash String
  role         UserRole
  isActive     Boolean   @default(true)
  companyId    String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  projects     Project[] @relation("ProjectForeman")
  tasks        Task[]    @relation("TaskWorker")
  photos       PhotoReport[]
  auditLogs    AuditLog[]

  @@index([companyId])
  @@index([role])
}

model Project {
  id          String        @id @default(cuid())
  companyId   String
  title       String
  description String
  startsAt    DateTime
  dueAt       DateTime
  foremanId   String
  status      ProjectStatus
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  company     Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  foreman     User          @relation("ProjectForeman", fields: [foremanId], references: [id], onDelete: Restrict)
  stages      Stage[]
  tasks       Task[]
  materials   Material[]

  @@index([companyId])
  @@index([status])
}

model Material {
  id        String         @id @default(cuid())
  projectId String
  name      String
  quantity  Float
  unit      String
  status    MaterialStatus @default(planned)
  cost      Float?
  supplier  String?        @db.Text
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
}

model Stage {
  id        String      @id @default(cuid())
  projectId String
  title     String
  startsAt  DateTime
  dueAt     DateTime
  status    StageStatus
  order     Int
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@unique([projectId, order])
  @@index([projectId])
  @@index([status])
}

model Task {
  id                 String       @id @default(cuid())
  projectId          String
  stageId            String
  workerId           String
  title              String
  status             TaskStatus
  requiresAfterPhoto Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage              Stage        @relation(fields: [stageId], references: [id], onDelete: Cascade)
  worker             User         @relation("TaskWorker", fields: [workerId], references: [id], onDelete: Restrict)
  photos             PhotoReport[]

  @@index([projectId])
  @@index([stageId])
  @@index([workerId])
  @@index([status])
}

model PhotoReport {
  id         String    @id @default(cuid())
  taskId      String
  kind        PhotoKind
  url         String
  uploadedBy  String
  uploadedAt  DateTime  @default(now())
  attempt     Int       @default(1)
  createdAt   DateTime  @default(now())
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  uploader    User      @relation(fields: [uploadedBy], references: [id], onDelete: Restrict)

  @@index([taskId])
  @@index([kind])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  entityType String
  entityId   String
  details    String?
  createdAt  DateTime @default(now())
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([actorId])
  @@index([entityType, entityId])
}
